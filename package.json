{
    "private": true,
    "name": "guillaumecisco",
    "packageManager": "yarn@4.13.0",
    "productName": "Guillaume Cisco Website",
    "author": "Guillaume Cisco <guillaumecisco@gmail.com>",
    "version": "0.0.1",
    "license": "MIT",
    "description": "Guillaume Cisco's website",
    "repository": {
        "type": "git",
        "url": "https://github.com/GuillaumeCisco/guillaumecisco"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "clean:webpack": "cd packages/webpack && npm run clean",
        "clean": "yarn clean:webpack",
        "certs": "mkdir -p certs && mkcert -key-file certs/localhost+2-key.pem -cert-file certs/localhost+2.pem localhost 127.0.0.1 ::1",
        "dev": "./node_modules/.bin/concurrently -n CLIENT,SSR,SERVER -c blue,green,yellow \"yarn dev:client\" \"yarn dev:ssr\" \"yarn dev:server\"",
        "dev:client": "cd packages/webpack && yarn dev:client",
        "dev:ssr": "cd packages/webpack && yarn dev:ssr",
        "dev:server": "./node_modules/.bin/wait-on public/dist/node/static/js/main.js && ./node_modules/.bin/cross-env NODE_ENV=development nodemon --watch public/dist/node/static/js/main.js --exec \"node\" public/dist/node/static/js/main.js",
        "start": "NODE_ENV=production node public/dist/node/static/js/main.js",
        "build": "yarn clean && NODE_ENV=production yarn build:webpack",
        "build:dev": "yarn clean && NODE_ENV=development yarn build:webpack",
        "build:webpack": "cd packages/webpack && npm run build",
        "test": "cd packages/test && npm run test",
        "cover": "cd packages/test && npm run cover",
        "eslint": "cd packages/eslint && npm run eslint",
        "deploy": "tools/deploy.js",
        "prepare": "husky",
        "tauri:dev": "cd packages/tauri && yarn dev",
        "tauri:web": "NODE_ENV=development ./node_modules/.bin/rspack serve -c config/rspack.tauri.config.js",
        "tauri:build": "cd packages/tauri && npm run build"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "husky": "9.1.7",
        "nodemon": "3.1.14"
    },
    "resolutions": {
        "@babel/plugin-transform-modules-systemjs": "7.29.4",
        "brace-expansion@^1.1.0": "1.1.13",
        "diff": "8.0.3",
        "fast-uri": "3.1.2",
        "flatted": "3.4.2",
        "ip-address": "10.2.0",
        "lodash": "4.18.1",
        "node-forge": "1.4.0",
        "path-to-regexp@npm:~0.1.12": "0.1.13",
        "picomatch@^4.0.0": "4.0.4",
        "picomatch@^2.0.0": "2.3.2",
        "postcss": "8.5.14",
        "serialize-javascript": "7.0.5",
        "tar": "7.5.11",
        "ws": "8.20.1",
        "yaml": "1.10.3"
    }
}
