{
    "name": "webpack-package",
    "productName": "Guillaume Cisco's Website",
    "author": "Guillaume Cisco <guillaumecisco@gmail.com>",
    "version": "0.0.1",
    "license": "MIT",
    "description": "Guillaume Cisco's website",
    "repository": {
        "type": "git",
        "url": "https://github.com/GuillaumeCisco/guillaumecisco"
    },
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=5.3.0"
    },
    "pre-commit": [
        "precommit-msg",
        "test",
        "eslint"
    ],
    "devDependencies": {
        "@aaroon/workbox-rspack-plugin": "0.3.3",
        "@loadable/webpack-plugin": "5.15.2",
        "@rspack/cli": "2.0.2",
        "@rspack/core": "2.0.2",
        "@rspack/dev-client": "0.4.1",
        "@rspack/dev-middleware": "2.0.1",
        "@rspack/dev-server": "2.0.1",
        "@rspack/plugin-react-refresh": "2.0.0",
        "@sentry/webpack-plugin": "5.2.1",
        "@svgr/webpack": "8.1.0",
        "@swc/plugin-emotion": "14.9.0",
        "add-asset-webpack-plugin": "3.1.1",
        "autoprefixer": "10.4.27",
        "case-sensitive-paths-webpack-plugin": "2.4.0",
        "css-loader": "7.1.4",
        "eslint-webpack-plugin": "6.0.0",
        "fork-ts-checker-webpack-plugin": "9.1.0",
        "lodash-webpack-plugin": "0.11.6",
        "postcss": "8.5.10",
        "postcss-flexbugs-fixes": "5.0.2",
        "postcss-loader": "8.2.1",
        "postcss-normalize": "13.0.1",
        "postcss-preset-env": "11.2.0",
        "resolve-url-loader": "5.0.0",
        "rspack-manifest-plugin": "5.2.1",
        "rspack-plugin-virtual-module": "1.0.1",
        "sass-loader": "16.0.7",
        "source-map-loader": "5.0.0",
        "style-loader": "4.0.0",
        "webpack": "5.106.2",
        "webpack-bundle-analyzer": "5.2.0",
        "webpack-dev-middleware": "7.4.2",
        "webpack-hot-middleware": "2.26.1",
        "webpack-node-externals": "3.0.0",
        "webpack-virtual-modules": "0.6.2"
    },
    "scripts": {
        "dev:client": "cd ../../ && NODE_ENV=development ./node_modules/.bin/rspack serve -c config/rspack.client.config.js",
        "dev:ssr": "cd ../../ && NODE_ENV=development ./node_modules/.bin/rspack build -c config/rspack.ssr.config.js --watch",
        "dev:server": "cd ../../ && NODE_ENV=development nodemon public/dist/node/static/js/main.js",
        "build": "cd ../../ && NODE_ENV=production ./node_modules/.bin/rspack build -c config/rspack.client.config.js && NODE_ENV=production rspack build -c config/rspack.ssr.config.js",
        "build:client": "cd ../../ && NODE_ENV=production ./node_modules/.bin/rspack build -c config/rspack.client.config.js",
        "build:server": "cd ../../ && NODE_ENV=production ./node_modules/.bin/rspack build -c config/rspack.ssr.config.js",
        "clean": "cd ../../ && rimraf public/dist && cd -"
    }
}
